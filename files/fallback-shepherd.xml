<!--
  Fallback daemon set: networking only, no soundspin.

  Installed to /mnt/nv/good-shepherd.xml (deliberately OUTSIDE /mnt/nv/shepherd
  so shepherdd does not read it as an active config). netwatch.sh copies this
  over the live override and reboots if the network is unusable after boot,
  which restores a reachable device without physical access.

  Like Shepherd-soundspin.xml this is a template; see there for the Firewall
  interface placeholder and rules.
-->
<ShepherdConfig>
  <daemon name="Firewall">
    <!--FIREWALL_INTERFACES-->
    <arg>/mnt/nv/firewall.sh</arg>
  </daemon>

  <daemon name="NetManager"
          recovery="reboot">
    <arg>--autoswitching=true</arg>
  </daemon>
</ShepherdConfig>
